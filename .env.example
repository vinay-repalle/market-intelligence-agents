# Copy to .env for local runs (cp .env.example .env) and fill in real values.
# .env is git-ignored. In GitHub Actions, use repository Secrets with these same names.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model-name
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional tuning (defaults shown)
# MAX_STORIES=10
# LOOKBACK_HOURS=36

# --- Stock Market Agent (same Gemini key/model and bot token as above) ---
# Separate Telegram group for the stock report
TELEGRAM_STOCK_CHAT_ID=your-stock-group-chat-id
# Optional: comma-separated NSE symbols (.NS added automatically), max 15
STOCK_WATCHLIST=RELIANCE,TCS,HDFCBANK
# Optional: STOCK_LOOKBACK_HOURS (default 30), STOCK_MAX_HEADLINES (default 8)
